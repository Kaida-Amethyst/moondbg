{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 moondbg 扩展（开发窗口）",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "env": {
        "MOON_HOME": "${env:HOME}/.moon",
        "PATH": "${env:HOME}/.moon/bin:${env:PATH}"
      },
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode",
        "${workspaceFolder}/testdata/dwarf_probe"
      ]
    }
  ]
}
