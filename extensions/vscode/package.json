{
  "name": "moondbg",
  "displayName": "moondbg (Preview)",
  "description": "通过 moondbg 构建并调试 MoonBit native 程序。",
  "version": "0.1.1",
  "publisher": "moondbg-local",
  "private": true,
  "preview": true,
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/Kaida-Amethyst/moondbg.git", "directory": "extensions/vscode" },
  "bugs": { "url": "https://github.com/Kaida-Amethyst/moondbg/issues" },
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "调试会构建并运行工作区程序，请先确认信任此工作区。" },
    "virtualWorkspaces": { "supported": false }
  },
  "files": ["extension.js", "launcher.js", "configuration.js", "discovery.js", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onCommand:moondbg.showStatus", "onCommand:moondbg.debugCurrentPackage", "onDebugResolve:moondbg", "onDebugInitialConfigurations"],
  "contributes": {
    "configuration": {
      "title": "moondbg",
      "properties": {
        "moondbg.moonHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "MoonBit 工具链目录，例如 `~/.moon` 或 `/Users/你的用户名/.moon`。留空使用扩展进程的 `MOON_HOME`；不搜索 PATH。扩展启动该目录下的 `bin/moondbg`，并把此目录作为 MOON_HOME 传给调试器。"
        }
      }
    },
    "breakpoints": [{ "language": "moonbit" }],
    "commands": [
      {
        "command": "moondbg.debugCurrentPackage",
        "title": "调试当前包",
        "category": "moondbg"
      },
      {
        "command": "moondbg.showStatus",
        "title": "检查扩展加载",
        "category": "moondbg"
      }
    ],
    "debuggers": [
      {
        "type": "moondbg",
        "label": "moondbg",
        "languages": ["moonbit"],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "connectionTest": {
                "type": "boolean",
                "default": false,
                "description": "仅验证 DAP 初始化和会话结束，不启动用户程序。"
              },
              "program": {
                "type": "string",
                "description": "已使用 -g -O0 编译的可执行文件绝对路径，不重新构建；与 package 二选一。"
              },
              "package": {
                "type": "string",
                "description": "MoonBit 可执行包的绝对目录路径；每次 F5 自动构建后调试，与 program 二选一。可使用 ${workspaceFolder}。"
              },
              "cwd": {
                "type": "string",
                "description": "程序工作目录（绝对路径）。package 模式默认项目根目录；program 模式默认可执行文件所在目录。不改变构建根目录。"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "moondbg",
            "request": "launch",
            "name": "moondbg：调试当前包",
            "internalConsoleOptions": "openOnSessionStart"
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test extension.test.js launcher.test.js packaging.test.js configuration.test.js discovery.test.js",
    "package": "npm test && node scripts/package.js"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
