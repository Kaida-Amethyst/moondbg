fn main {
  let x: Int = 33;
  println("x is Int: \{x}");
  let y: Float = 125.5;
  println("y is Float: \{y}");
  let z: Bool = true;
  println("z is Bool: \{z}");
  let a: Int64 = -42;
  println("a is Int64: \{a}");
  let b: UInt64 = 133;
  println("b is UInt64: \{b}");
  let c: Double = 12345.5;
  println("c is Double: \{c}");
}
