{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "moondbg",
      "request": "launch",
      "name": "moondbg：DAP 连接验证（不运行程序）",
      "connectionTest": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "moondbg",
      "request": "launch",
      "name": "moondbg：调试 main（预编译）",
      "program": "${workspaceFolder}/_build/native/debug/build/main/main.exe",
      "cwd": "${workspaceFolder}",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
